# 1. Server Config
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# 2. CORS Whitelist (nhieu origin cach nhau bang dau phay - Muc 12 & 13)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://animora-group14.vercel.app

# 3. SQL Server Database (Khop voi docker-compose.yml)
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=Animora@2026StrongPass!
DB_NAME=AnimoraDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# 4. JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# 5. VNPAY Sandbox Config (Toan phu trach - Muc 18.6)
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment-result

# 6. Google Gemini AI (Hoang phu trach - AI-01..05)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=8000
GEMINI_MAX_RETRIES=2

# 7. SMTP Email - Quen mat khau (Toan phu trach - Muc 18.5)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# 8. Storage - Direct-to-Cloud pre-signed URL (EXP-01)
STORAGE_BASE_URL=http://localhost:5000/uploads
STORAGE_PRESIGN_SECRET=animora_storage_presign_secret_group14
STORAGE_PRESIGN_EXPIRES_SEC=300

# 9. Background jobs (INV-04 low stock, NTF-01 reminder)
JOBS_ENABLED=true

# 10. Google OAuth 2.0 (Login with Google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
